{
  "mappings": [
    {
      "id": "activate-success",
      "priority": 1,
      "request": {
        "method": "POST",
        "url": "/provider/v1/activate"
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "application/json"
        },
        "jsonBody": {
          "activationId": "prov-{{request.headers.Idempotency-Key}}",
          "status": "ACTIVE"
        }
      }
    }
  ]
}
